# Copy to .env for local development. Never commit real values.
# In production these are set as Railway service variables.

# PostgreSQL connection string. Without it the server runs with no DB
# (alarms and favorites are disabled).
DATABASE_URL=postgresql://user:password@localhost:5432/clutch

# Firebase service account, as a single-line JSON string. Required to send pushes.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Bzzoiro Sports Data (BSD) API token. Without it BSD calls fail and the
# source cascade falls back to 365scores.
BZZOIRO_API_TOKEN=

# Secret for POST /admin/broadcast (sent as the X-Admin-Key header).
# If unset, the endpoint rejects every request.
ADMIN_KEY=

# Device push token that receives schema-canary alerts when 365scores
# responses stop matching the expected format.
ADMIN_FCM_TOKEN=

# Max concurrent sync route handlers (default 96).
# SYNC_THREAD_LIMIT=96

# Enables staged demo matches for App Store screenshots. Leave unset in production.
# SCREENSHOT_DEMO=1

# Set automatically by Railway; only needed when running uvicorn by hand.
# PORT=8001
