{
  "expo": {
    "name": "NBA-Alarm-App",
    "slug": "NBA-Alarm-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nbaalarmapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nadav.nbaalarmapp"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "WAKE_LOCK",
        "DISABLE_KEYGUARD",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1623",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.nadav.nbaalarmapp",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withTurnScreenOn",
      "./plugins/withSoundFiles",
      "./plugins/withAlarmAudioAttributes",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#0B1623",
          "dark": {
            "backgroundColor": "#0B1623"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9a20206e-3c2b-4b3e-8e4f-1c9813f4c605"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "nbasmartalarm"
  }
}
