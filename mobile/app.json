{
  "expo": {
    "name": "Nba Smart Alarm",
    "slug": "NBA-Alarm-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nbaalarmapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nadav.nbaalarmapp"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "WAKE_LOCK",
        "DISABLE_KEYGUARD",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1623",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.nadav.nbaalarmapp",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidSdkVersions",
      "./plugins/withTurnScreenOn",
      "./plugins/withSoundFiles",
      "./plugins/withAlarmAudioAttributes",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#0B1623",
          "dark": {
            "backgroundColor": "#0B1623"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bac39d54-8d6f-41e4-9afb-591085bb5dc1"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "nbasmartalarm1"
  }
}
